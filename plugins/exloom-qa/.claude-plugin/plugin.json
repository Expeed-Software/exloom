{
  "name": "exloom-qa",
  "description": "Team-oriented QA workflow for Claude Code — turns a user story into reviewed, traceable, human-executable manual test cases, published to Azure DevOps only after explicit QA approval.",
  "version": "0.1.8",
  "author": {
    "name": "Expeed Software",
    "email": "support@expeed.com"
  },
  "repository": "https://github.com/Expeed-Software/exloom",
  "license": "MIT",
  "keywords": [
    "qa",
    "testing",
    "test-cases",
    "manual-testing",
    "azure-devops",
    "test-design",
    "coverage",
    "traceability",
    "team",
    "review"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/block-unapproved-publish.sh"
          }
        ]
      }
    ]
  }
}
