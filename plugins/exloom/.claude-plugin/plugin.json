{
  "name": "exloom",
  "description": "Team-oriented development workflow for Claude Code — discipline, handoff, and an enforced evidence-based review gate. Scales from one developer to a whole org.",
  "version": "1.3.0",
  "author": {
    "name": "Expeed Software",
    "email": "support@expeed.com"
  },
  "repository": "https://github.com/Expeed-Software/exloom",
  "license": "MIT",
  "keywords": [
    "workflow",
    "development",
    "planning",
    "code-review",
    "debugging",
    "test-driven-development",
    "brownfield",
    "team",
    "review",
    "handoff"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/verify-review.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/block-unverified-push.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*(push_files|create_or_update_file|create_pull_request|merge_pull_request|delete_file)",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/block-unverified-push.sh"
          }
        ]
      }
    ]
  }
}
