{
  "name": "exloom",
  "description": "Evidence for team code review on Claude Code — a spec, a plan, a mechanical proof that your tests notice your change, and reviewer receipts, gated once at push.",
  "version": "6.0.5",
  "icon": "assets/icon.svg",
  "author": {
    "name": "Expeed Software",
    "email": "support@expeed.com"
  },
  "repository": "https://github.com/Expeed-Software/exloom",
  "license": "MIT",
  "keywords": [
    "workflow",
    "development",
    "planning",
    "code-review",
    "brownfield",
    "team",
    "review",
    "handoff"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/record-reviewer-verdict.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/guard-reviewer-dispatch.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/protect-verdicts.sh"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file|mcp__github__create_pull_request|mcp__github__merge_pull_request|mcp__plugin_github_github__push_files|mcp__plugin_github_github__create_or_update_file|mcp__plugin_github_github__delete_file|mcp__plugin_github_github__create_pull_request|mcp__plugin_github_github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/block-unverified-push.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/guard-fix-loop.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/record-reviewer-verdict.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "userConfig": {
    "verbose": {
      "type": "boolean",
      "title": "Full gate messages",
      "description": "Show the full explanation when the gate blocks, instead of one line and '/exloom' for the rest.",
      "default": false
    }
  }
}
